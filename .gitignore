# Terraform state files
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform.lock.hcl

# Sensitive variable files (never commit secrets)
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash log files
crash.log
crash.*.log

# Python local/runtime files
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.venv/
**/venv/

# Node local/runtime files
**/node_modules/
**/dist/
**/coverage/
**/.vite/

# Local application configuration
**/.env
*.local

# Logs
**/logs/
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
